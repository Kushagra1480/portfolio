---
import Base from '../layouts/Base.astro';

const featured = [
  {
    name: 'Tabscope',
    headline: 'Find any tab before you finish typing.',
    desc: 'A Telescope-style fuzzy switcher for the browser — hundreds of open tabs, one keystroke away.',
    img: '/images/tabscope-preview.webp',
    alt: 'Tabscope — a magnifying glass sweeping a beam of light',
    href: '#',
    flip: false,
  },
  {
    name: 'Raijin',
    headline: 'Watch the sky move in real time.',
    desc: "WindBorne's weather-balloon constellation, layered with live precipitation from the RainViewer API.",
    img: '/images/raijin-preview.webp',
    alt: 'Raijin — a real-time weather map illustration',
    href: '#',
    flip: true,
  },
];

const homePosts = [
  { title: 'The queue was the answer the whole time', href: '/writing/queue', readTime: '8 min' },
  { title: 'Why my LLM stream died at exactly 45 seconds', href: '/writing/streams', readTime: '6 min' },
  { title: 'A token broker that let my sandbox call APIs it could never authenticate to', href: '/writing/broker', readTime: '9 min' },
  { title: "The rename you're afraid to do: migrating a live database", href: '/writing/migrations', readTime: '7 min' },
  { title: "The feature was built. It just didn't do anything.", href: '/writing/nothing', readTime: '6 min' },
];
---
<Base>
  <div class="home">
    <header class="hero">
      <h1>Kushagra Kartik</h1>
      <p class="tagline">agent runtime @ <span>1Sphere AI</span></p>
      <div class="meta">
        <span class="loc">San Francisco, CA</span>
        <span class="dot">/</span>
        <a href="https://github.com/Kushagra1480" target="_blank">GitHub</a>
        <a href="https://linkedin.com/in/kushagra-kartik" target="_blank">LinkedIn</a>
        <a href="/resume.pdf" target="_blank">Resume</a>
      </div>
    </header>

    <section class="work">
      <div class="section-head">
        <h2 class="section-kicker">Selected work</h2>
        <a href="/projects">all projects →</a>
      </div>
      <div class="cards">
        {featured.map((p) => (
          <article class:list={['work-card', { flip: p.flip }]}>
            <a class="card-media" href={p.href} aria-label={p.name}>
              <img src={p.img} alt={p.alt} width="1600" height={p.flip ? 1280 : 900} loading="lazy" />
            </a>
            <div class="card-copy">
              <h3>{p.headline}</h3>
              <p>{p.desc}</p>
              <a class="view" href={p.href}>View project <span class="arw">→</span></a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="writing-recent">
      <div class="section-head">
        <h2 class="section-kicker">Recent writing</h2>
        <a href="/writing">all posts →</a>
      </div>
      {homePosts.map((post) => (
        <a class="post-row" href={post.href}>
          <span class="post-title">{post.title}</span>
          <span class="post-read">{post.readTime} · read <span class="arw">→</span></span>
        </a>
      ))}
    </section>

    <footer class="home-footer">
      <div class="footer-inner">
        <a href="mailto:1kushagrakartik@gmail.com" class="email">1kushagrakartik@gmail.com</a>
        <div class="footer-links">
          <a href="https://github.com/Kushagra1480" target="_blank">GitHub</a>
          <a href="https://linkedin.com/in/kushagra-kartik" target="_blank">LinkedIn</a>
          <a href="/resume.pdf" target="_blank">Resume</a>
        </div>
      </div>
    </footer>
  </div>
</Base>

<style>
  .home { max-width: 1040px; margin: 0 auto; }

  /* hero — roomy */
  .hero { padding: 190px 0 108px; max-width: 720px; }
  .hero h1 {
    font-family: var(--sans);
    font-size: 72px;
    line-height: 1.0;
    font-weight: 600;
    letter-spacing: -0.03em;
    margin: 0;
    color: var(--ink);
  }
  .tagline {
    font-size: 22px;
    line-height: 1.4;
    color: var(--ink-2);
    font-weight: 400;
    margin: 22px 0 0;
  }
  .tagline span { color: var(--ink); font-weight: 500; }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-top: 30px;
    font-family: var(--mono);
    font-size: 12.5px;
  }
  .meta .loc { color: var(--ink-3); }
  .meta .dot { color: var(--hair); }
  .meta a { color: var(--ink-2); }
  .meta a:hover { color: var(--accent); }

  /* selected work */
  .work { padding-top: 36px; }
  .cards { display: flex; flex-direction: column; gap: 32px; margin-top: 48px; }

  .work-card {
    display: grid;
    grid-template-columns: 60fr 40fr;
    align-items: stretch;
    background: var(--paper);
    border: 1px solid var(--hair);
    border-radius: 8px;
    overflow: hidden;
    min-height: 400px;
  }
  .work-card.flip { grid-template-columns: 40fr 60fr; }
  .card-media { display: block; background: var(--stage); }
  .work-card.flip .card-media { order: 2; }
  .card-media img { width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; }

  .card-copy { align-self: center; padding: 64px 60px; }
  .work-card.flip .card-copy { order: 1; }
  .card-copy h3 {
    font-family: var(--sans);
    font-size: 27px;
    line-height: 1.16;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0;
    text-wrap: balance;
  }
  .card-copy p {
    font-size: 14.5px;
    line-height: 1.62;
    color: var(--ink-2);
    margin: 18px 0 0;
    max-width: 34ch;
    text-wrap: pretty;
  }
  .card-copy .view {
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.02em;
    color: var(--accent);
    margin-top: 32px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .card-copy .view .arw { transition: transform 0.3s cubic-bezier(0.34, 1.3, 0.6, 1); }
  .card-copy .view:hover .arw { transform: translateX(5px); }

  /* recent writing */
  .writing-recent { padding-top: 88px; }
  .writing-recent .section-head { margin-bottom: 6px; }
  .post-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 28px;
    padding: 22px 0;
    border-bottom: 1px solid var(--hair);
    color: inherit;
  }
  .post-title {
    font-family: var(--sans);
    font-size: 19px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--ink-2);
    transition: color 0.3s ease;
    text-wrap: pretty;
  }
  .post-row:hover .post-title { color: var(--ink); }
  .post-read {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-3);
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .post-read .arw { transition: transform 0.3s cubic-bezier(0.34, 1.3, 0.6, 1); }
  .post-row:hover .post-read .arw { transform: translateX(4px); }

  /* footer */
  .home-footer { padding-top: 96px; }
  .footer-inner {
    border-top: 1px solid var(--hair);
    padding-top: 36px;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
  }
  .email { font-family: var(--mono); font-size: 13px; color: var(--ink-2); }
  .email:hover { color: var(--accent); }
  .footer-links { display: flex; gap: 20px; font-family: var(--mono); font-size: 12.5px; }
  .footer-links a { color: var(--ink-3); }
  .footer-links a:hover { color: var(--accent); }

  @media (max-width: 820px) {
    .hero { padding-top: 130px; }
    .hero h1 { font-size: 50px; }
    .work-card, .work-card.flip { grid-template-columns: 1fr; min-height: 0; }
    .work-card.flip .card-media { order: 0; }
    .work-card.flip .card-copy { order: 0; }
    .card-media img { aspect-ratio: 16 / 10; height: auto; }
    .card-copy { padding: 40px 34px 44px; }
  }
</style>
