---
import Base from '../layouts/Base.astro';

const posts = [
  {
    topic: 'Security · Multi-tenancy',
    title: 'A token broker that let my sandbox call APIs it could never authenticate to',
    excerpt:
      "How an untrusted, autonomous agent reaches a customer's credentialed API without ever touching the credential — identity from an unforgeable token claim, never a request header.",
    href: '/writing/broker',
    readTime: '9 min',
    img: '/images/broker.png',
  },
  {
    topic: 'Sandboxing · microVMs',
    title: 'The LLM wrote the code. Now where do you run it?',
    excerpt:
      'Running model-authored, attacker-influenced code means matching the isolation boundary to the threat. Why containers are the wrong default and microVMs are the sweet spot.',
    href: '/writing/sandbox',
    readTime: '10 min',
    img: '/images/sandbox.png',
  },
  {
    topic: 'Distributed systems · Queues',
    title: 'The queue was the answer the whole time',
    excerpt:
      "A distributed job system whose hardest bug wasn't the jobs — it was delivering the completion signal. When a message can't route, change the road, not the messenger.",
    href: '/writing/queue',
    readTime: '8 min',
    img: '/images/queue.webp',
  },
  {
    topic: 'Streaming · Go',
    title: 'Why my LLM stream died at exactly 45 seconds',
    excerpt:
      'A Go WriteTimeout guillotine, an EventSource that never reports its own death, and why I deleted the streaming code and shipped a polling loop instead.',
    href: '/writing/streams',
    readTime: '6 min',
    img: '/images/streams.webp',
  },
  {
    topic: 'Migrations · Live systems',
    title: "The rename you're afraid to do",
    excerpt:
      'Migrating a live, stateful database without a big bang. The ordering is the whole lesson: dual-shape reads, canonical-only writes, and never leave the old path both required and unsupported.',
    href: '/writing/migrations',
    readTime: '7 min',
    img: '/images/migrations.webp',
  },
  {
    topic: 'Debugging · Silent failures',
    title: "The feature was built. It just didn't do anything.",
    excerpt:
      'Four bugs across four layers, one disease: successful nothing. Green dashboards, exit code 0, and features that quietly never ran.',
    href: '/writing/nothing',
    readTime: '6 min',
    img: '/images/nothing.webp',
  },
];
---
<Base title="Writing — Kushagra Kartik">
  <div class="writing">
    <header class="writing-header">
      <div class="section-kicker">Writing</div>
    </header>
    <section class="grid">
      {posts.map((post) => (
        <a class="card" href={post.href}>
          <div class="card-img">
            <img src={post.img} alt={post.title} loading="lazy" />
          </div>
          <div class="card-topic"><span class="tick"></span>{post.topic}</div>
          <div class="title-wrap">
            <h2 class="card-title">{post.title}</h2>
            <span class="rule"></span>
          </div>
          <p class="card-excerpt">{post.excerpt}</p>
          <div class="card-foot">
            <span class="read">read <span class="arw">→</span></span>
            <span class="read-time">{post.readTime} read</span>
          </div>
        </a>
      ))}
    </section>
  </div>
</Base>

<style>
  .writing { max-width: 1300px; margin: 0 auto; }
  .writing-header { padding: 180px 0 60px; max-width: 760px; }

  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 48px 40px; }

  .card { display: flex; flex-direction: column; color: inherit; }

  .card-img {
    border-radius: 8px;
    overflow: hidden;
    background: var(--stage);
    border: 1px solid var(--hair);
    box-shadow: 0 12px 30px -26px rgba(28, 32, 18, 0.4);
    aspect-ratio: 16 / 10;
    margin-bottom: 20px;
  }
  .card-img img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* rest slightly cool + dim, then bloom to life on hover — no lift, no zoom-pop */
    filter: saturate(0.82) brightness(0.99) contrast(1.02);
    transition: transform 1.15s cubic-bezier(0.16, 0.7, 0.2, 1), filter 0.6s ease;
  }
  .card:hover .card-img img {
    filter: saturate(1.06) brightness(1.03) contrast(1.03);
    transform: scale(1.035);
  }

  .card-topic {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 11px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .card-topic .tick { width: 0; height: 1px; background: var(--accent); transition: width 0.34s cubic-bezier(0.4, 0, 0.2, 1); }
  .card:hover .card-topic .tick { width: 20px; }

  .title-wrap { position: relative; align-self: flex-start; }
  .card-title {
    font-family: var(--sans);
    font-size: 23px;
    line-height: 1.18;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0 0 11px;
    color: var(--ink-2);
    transition: color 0.3s ease;
    text-wrap: balance;
  }
  .card:hover .card-title { color: var(--ink); }
  .rule {
    position: absolute; left: 0; bottom: 6px;
    height: 1.5px; width: 100%;
    background: var(--accent);
    transform: scaleX(0); transform-origin: left;
    transition: transform 0.42s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .card:hover .rule { transform: scaleX(1); }

  .card-excerpt {
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-2);
    margin: 0 0 16px;
    text-wrap: pretty;
    opacity: 0.92;
  }
  .card-foot { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-top: auto; }
  .read { font-family: var(--mono); font-size: 12.5px; color: var(--ink); display: inline-flex; align-items: center; gap: 7px; }
  .read .arw { display: inline-block; transition: transform 0.3s cubic-bezier(0.34, 1.3, 0.6, 1); }
  .card:hover .read .arw { transform: translateX(5px); }
  .read-time { font-family: var(--mono); font-size: 11.5px; color: var(--ink-3); }

  @media (prefers-reduced-motion: reduce) {
    .card-img img, .rule, .tick, .card-title, .arw { transition: none !important; }
  }

  @media (max-width: 1000px) {
    .grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 820px) {
    .writing-header { padding-top: 120px; }
  }
</style>
