---
import Base from '../layouts/Base.astro';

const posts = [
  {
    topic: 'Security · Multi-tenancy',
    title: 'A token broker that let my sandbox call APIs it could never authenticate to',
    excerpt:
      "How an untrusted, autonomous agent reaches a customer's credentialed API without ever touching the credential — a broker pattern where identity comes from an unforgeable token claim, never a request header.",
    href: '/writing/broker',
    readTime: '9 min',
    img: '/images/broker.png',
  },
  {
    topic: 'Sandboxing · microVMs',
    title: 'The LLM wrote the code. Now where do you run it?',
    excerpt:
      'Running model-authored, attacker-influenced code means matching the isolation boundary to the threat. Why containers are the wrong default, why microVMs are the sweet spot, and the low-level userland bill Firecracker hands you.',
    href: '/writing/sandbox',
    readTime: '10 min',
    img: '/images/sandbox.png',
  },
  {
    topic: 'Distributed systems · Queues',
    title: 'The queue was the answer the whole time',
    excerpt:
      "A distributed job system whose hardest bug wasn't the jobs — it was delivering the completion signal. When a message can't route, change the road, not the messenger.",
    href: '/writing/queue',
    readTime: '8 min',
    img: '/images/queue.webp',
  },
  {
    topic: 'Streaming · Go',
    title: 'Why my LLM stream died at exactly 45 seconds',
    excerpt:
      'A Go WriteTimeout guillotine, an EventSource that never reports its own death, and why I deleted the streaming code and shipped a polling loop instead.',
    href: '/writing/streams',
    readTime: '6 min',
    img: '/images/streams.webp',
  },
  {
    topic: 'Migrations · Live systems',
    title: "The rename you're afraid to do",
    excerpt:
      'Migrating a live, stateful database without a big bang. The ordering is the whole lesson: dual-shape reads, canonical-only writes, and never leave the old path both required and unsupported.',
    href: '/writing/migrations',
    readTime: '7 min',
    img: '/images/migrations.webp',
  },
  {
    topic: 'Debugging · Silent failures',
    title: "The feature was built. It just didn't do anything.",
    excerpt:
      'Four bugs across four layers, one disease: successful nothing. Green dashboards, exit code 0, and features that quietly never ran.',
    href: '/writing/nothing',
    readTime: '6 min',
    img: '/images/nothing.webp',
  },
  {
    topic: 'Tools · Interfaces',
    title: 'Eternal Chaos of the Tab-less Mind',
    excerpt:
      'On building a keyboard-first, fuzzy-searchable tab switcher — and what hundreds of open tabs say about how we actually think while we work.',
    href: '/writing',
    readTime: '5 min',
    img: '/images/tabs.webp',
  },
];
---
<Base title="Writing — Kushagra Kartik">
  <div class="writing">
    <header class="writing-header">
      <div class="kicker">Writing</div>
    </header>
    <section class="grid">
      {posts.map((post) => (
        <a class="card" href={post.href}>
          <div class="card-img">
            <img src={post.img} alt={post.title} />
          </div>
          <div class="card-topic">{post.topic}</div>
          <h2 class="card-title">{post.title}</h2>
          <p class="card-excerpt">{post.excerpt}</p>
          <div class="card-foot">
            <span class="read">read →</span>
            <span class="read-time">{post.readTime} read</span>
          </div>
        </a>
      ))}
    </section>
  </div>
</Base>

<style>
  .writing { max-width: 1300px; margin: 0 auto; }
  .writing-header { padding: 180px 0 64px; max-width: 760px; }
  .kicker {
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-4);
    margin-bottom: 20px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 44px 40px;
  }
  .card {
    display: flex;
    flex-direction: column;
    color: inherit;
  }
  .card:hover { color: var(--link-hover); }
  .card-img {
    border-radius: 14px;
    overflow: hidden;
    background: var(--tag-bg);
    border: 1px solid var(--border-soft);
    box-shadow: 0 24px 60px -34px rgba(28, 26, 23, 0.45);
    aspect-ratio: 16 / 10;
    position: relative;
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.5s ease;
    margin-bottom: 22px;
  }
  .card-img img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .card:hover .card-img {
    transform: translateY(-8px);
    box-shadow: 0 44px 90px -32px rgba(20, 32, 48, 0.55);
  }
  .card:hover .card-img img { transform: scale(1.08); }
  .card-topic {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-4);
    margin-bottom: 10px;
  }
  .card-title {
    font-size: 26px;
    line-height: 1.14;
    font-weight: 500;
    letter-spacing: -0.015em;
    margin: 0 0 10px;
    text-wrap: pretty;
  }
  .card-excerpt {
    font-size: 16px;
    line-height: 1.5;
    color: var(--muted-2);
    margin: 0 0 14px;
    text-wrap: pretty;
  }
  .card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: auto;
  }
  .read { font-family: var(--mono); font-size: 13px; color: var(--ink); }
  .read-time { font-family: var(--mono); font-size: 12px; color: var(--muted-4); }

  @media (max-width: 820px) {
    .grid { grid-template-columns: 1fr; }
    .writing-header { padding-top: 120px; }
  }
</style>
