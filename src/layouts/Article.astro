---
import Base from './Base.astro';

interface Props {
  title: string;
  body: string;
  mermaid?: string;
}

const { title, body, mermaid } = Astro.props;
---
<Base title={`${title} — Kushagra Kartik`} description={title}>
  <div class="article" set:html={body}></div>
</Base>

{mermaid && <script is:inline set:html={`window.__mermaidSrc=${JSON.stringify(mermaid)};`} />}

{mermaid && (
  <script is:inline>
    (function () {
      function draw() {
        const el = document.querySelector('.mermaid-target');
        const src = window.__mermaidSrc;
        if (!el || !src) return;
        if (el.__done && el.querySelector("svg:not([aria-roledescription='error'])")) return;
        function run() {
          if (!window.mermaid) return;
          el.__done = true;
          el.removeAttribute('data-processed');
          el.textContent = src;
          window.mermaid.initialize({
            startOnLoad: false,
            theme: 'base',
            securityLevel: 'loose',
            fontFamily: "'JetBrains Mono', monospace",
            themeVariables: {
              background: '#181825',
              primaryColor: '#313244',
              primaryBorderColor: '#585b70',
              primaryTextColor: '#cdd6f4',
              lineColor: '#9399b2',
              actorBkg: '#313244',
              actorBorder: '#585b70',
              actorTextColor: '#cdd6f4',
              signalColor: '#9399b2',
              signalTextColor: '#cdd6f4',
              noteBkgColor: '#cba6f7',
              noteTextColor: '#1e1e2e',
              noteBorderColor: '#cba6f7',
            },
          });
          try { window.mermaid.run({ nodes: [el] }); } catch (e) {}
        }
        if (window.mermaid) { run(); return; }
        if (window.__mermaidLoading) { window.__mermaidLoading.then(run); return; }
        window.__mermaidLoading = new Promise((res) => {
          const s = document.createElement('script');
          s.src = 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js';
          s.onload = res;
          document.head.appendChild(s);
        });
        window.__mermaidLoading.then(run);
      }
      if (!window.__mermaidHooked) {
        window.__mermaidHooked = true;
        document.addEventListener('astro:page-load', draw);
      }
      draw();
    })();
  </script>
)}

<style is:global>
  /* long-form reading stays in Newsreader serif; the rest of the site is Inter */
  .article { max-width: 680px; margin: 0 auto; font-family: var(--serif); }
  .article a { text-decoration: none; }
  .article p a,
  .article li a {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--hair);
    transition: color 0.3s ease, text-decoration-color 0.3s ease;
  }
  .article p a:hover,
  .article li a:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }
  .mermaid-target {
    background: #181825;
    border: 1px solid #313244;
    border-radius: 12px;
    padding: 26px 20px;
    margin: 0;
    overflow-x: auto;
    display: flex;
    justify-content: center;
    min-height: 280px;
    font-family: 'JetBrains Mono', monospace;
  }
</style>
