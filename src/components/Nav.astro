---
const items = [
  { id: 'home', label: 'home', href: '/', ix: '00' },
  { id: 'projects', label: 'projects', href: '/projects', ix: '01' },
  { id: 'writing', label: 'writing', href: '/writing', ix: '02' },
];
---
<nav class="site-nav" id="site-nav" transition:persist aria-label="Sections">
  <div class="nav-rail" id="nav-rail">
    <span class="nav-readhead" id="nav-readhead"></span>
    <span class="nav-bracket" id="nav-bracket"></span>
    {items.map((n) => (
      <a class="nav-item" data-id={n.id} href={n.href}>
        <span class="nav-ix">{n.ix}</span><span class="nav-label">{n.label}</span>
      </a>
    ))}
  </div>
  <div class="nav-hint" aria-hidden="true">
    <span class="hint-line"></span>
    <span class="hint-keys">
      <span class="kc mod">⇧</span><span class="kc">W</span>
      <span class="kc mod">⇧</span><span class="kc">S</span>
    </span>
    <span class="hint-label">move sections</span>
  </div>
</nav>

<script is:inline>
  (function () {
    const ORDER = ['home', 'projects', 'writing'];
    const HREF = { home: '/', projects: '/projects', writing: '/writing' };

    function currentId() {
      const p = location.pathname;
      if (p.startsWith('/writing')) return 'writing';
      if (p.startsWith('/projects')) return 'projects';
      return 'home';
    }

    function place(el, target) {
      if (!el || !target) return;
      target.style.transform = 'translateY(' + el.offsetTop + 'px)';
      target.style.width = el.offsetWidth + 'px';
      target.style.height = el.offsetHeight + 'px';
    }

    function paint() {
      const nav = document.getElementById('site-nav');
      if (!nav) return;
      const active = currentId();
      const bracket = document.getElementById('nav-bracket');
      let activeEl = null;
      nav.querySelectorAll('.nav-item').forEach((a) => {
        const on = a.dataset.id === active;
        a.classList.toggle('is-active', on);
        if (on) activeEl = a;
      });
      place(activeEl, bracket);
    }

    function wire() {
      const nav = document.getElementById('site-nav');
      if (!nav || nav.__wired) { paint(); return; }
      nav.__wired = true;
      const readhead = document.getElementById('nav-readhead');
      nav.querySelectorAll('.nav-item').forEach((a) => {
        a.addEventListener('mouseenter', () => { place(a, readhead); readhead.style.opacity = '1'; });
      });
      const rail = document.getElementById('nav-rail');
      rail.addEventListener('mouseleave', () => { readhead.style.opacity = '0'; });
      window.addEventListener('resize', () => { paint(); if (readhead) readhead.style.opacity = '0'; });
    }

    document.addEventListener('astro:page-load', () => { wire(); paint(); });

    if (!window.__navKeys) {
      window.__navKeys = true;
      window.addEventListener('keydown', (e) => {
        if (!e.shiftKey || e.metaKey || e.ctrlKey || e.altKey) return;
        const k = e.key.toLowerCase();
        if (k !== 'w' && k !== 's') return;
        const t = e.target;
        if (t && (t.isContentEditable || /^(input|textarea|select)$/i.test(t.tagName))) return;
        e.preventDefault();
        let i = ORDER.indexOf(currentId());
        if (i < 0) i = ORDER.length - 1;
        i = (i + (k === 'w' ? -1 : 1) + ORDER.length) % ORDER.length;
        const dest = HREF[ORDER[i]];
        if (window.__astroNavigate) window.__astroNavigate(dest);
        else location.href = dest;
      });
    }

    wire();
    paint();
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(paint);
  })();
</script>
